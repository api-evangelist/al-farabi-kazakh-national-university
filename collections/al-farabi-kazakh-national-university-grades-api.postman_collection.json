        {
          "id": "cc52502d-9d0d-4afe-a8a0-73dd56a8bfbe",
          "name": "**Use Case**",
          "request": {
            "name": "**Use Case**",
            "description": {
              "content": "Get the course grading policy.\n\n**Example requests**:\n\n    GET /api/grades/v1/policy/courses/{course_id}/\n\n**Response Values**\n\n    * assignment_type: The type of the assignment, as configured by course\n      staff. For example, course staff might make the assignment types Homework,\n      Quiz, and Exam.\n\n    * count: The number of assignments of the type.\n\n    * dropped: Number of assignments of the type that are dropped.\n\n    * weight: The weight, or effect, of the assignment type on the learner's\n      final grade.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "grades",
                "v1",
                "policy",
                "courses",
                ":course_id",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
