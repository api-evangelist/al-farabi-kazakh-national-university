        {
          "id": "b373725b-0dbd-4376-9210-7288f06a614a",
          "name": "Retrieve the User Tour for the given username.",
          "request": {
            "name": "Retrieve the User Tour for the given username.",
            "description": {
              "content": "Allows staff users to retrieve any user's User Tour.\n\nReturns\n    200 with the following fields:\n        course_home_tour_status (str): one of UserTour.CourseHomeChoices\n        show_courseware_tour (bool): indicates if courseware tour should be shown.\n\n    400 if there is a not allowed request (requesting a user you don't have access to)\n    401 if unauthorized request\n    403 if tours are disabled\n    404 if the UserTour does not exist (shouldn't happen, but safety first)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user_tours",
                "v1",
                ":username"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
