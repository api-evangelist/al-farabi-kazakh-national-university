            "method": "GET",
            "url": "https://open.kaznu.kz/api/xblock/v2/xblocks/:usage_key/",
            "params": [
              {
                "name": "usage_key",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Accepts the following query parameters:\n\n* \"include\": a comma-separated list of keys to include.\n  Valid keys are \"index_dictionary\" and \"student_view_data\"."
        },
        {
          "info": {
            "name": "xblock_v2_xblocks_fields_list",
            "type": "http"
