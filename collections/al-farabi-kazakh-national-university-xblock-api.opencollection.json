            "params": [
              {
                "name": "usage_key",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "retrieves the xblock, returning display_name, data, and metadata"
        },
        {
          "info": {
            "name": "xblock_v2_xblocks_fields_create",
            "type": "http"
