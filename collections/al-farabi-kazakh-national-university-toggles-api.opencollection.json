{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open edX agreements toggles API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "toggles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "toggles_v0_state_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.kaznu.kz/api/toggles/v0/state/"
          },
          "docs": "Expose toggle state report dict as a view."
        }
      ]
    }
  ],
  "bundled": true
}