{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open edX agreements univertest API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "univertest",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "univertest_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://open.kaznu.kz/api/univertest/"
          }
        }
      ]
    }
  ],
  "bundled": true
}